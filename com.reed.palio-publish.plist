<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Publishes the Palio app. Two triggers, belt and braces. -->

  <key>Label</key>
  <string>com.reed.palio-publish</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/reed/Documents/GitHub/Palio-di-Siena/publish-watch.command</string>
  </array>

  <!-- TRIGGER 1 — the moment the files change.
       launchd watches these paths and starts the job when either is written,
       which is what makes a refresh publish itself with nobody present. -->
  <key>WatchPaths</key>
  <array>
    <string>/Users/reed/Documents/GitHub/Palio-di-Siena/index.html</string>
    <string>/Users/reed/Documents/GitHub/Palio-di-Siena/sw.js</string>
  </array>

  <!-- TRIGGER 2 — the clock, as a safety net. If the Mac was asleep when the
       files arrived, the watch never fired; these catch up afterwards. Local
       time, so Eastern and daylight saving are handled for us. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>6</integer><key>Minute</key><integer>10</integer></dict>
    <dict><key>Hour</key><integer>12</integer><key>Minute</key><integer>10</integer></dict>
    <dict><key>Hour</key><integer>15</integer><key>Minute</key><integer>10</integer></dict>
  </array>

  <!-- Never start more than once a minute, however many files change. -->
  <key>ThrottleInterval</key>
  <integer>60</integer>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/reed/Library/Logs/palio-publish.out</string>
  <key>StandardErrorPath</key>
  <string>/Users/reed/Library/Logs/palio-publish.err</string>
</dict>
</plist>
